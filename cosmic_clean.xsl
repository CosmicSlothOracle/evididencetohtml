        .branding { white-space: pre; font-family: "VT323", monospace; font-size: 14px; line-height: 1.1; color: var(--hero-ascii-fg, var(--retro-14)); margin: 0; }
        .badge { display: inline-block; padding: 3px 8px; border-radius: 3px; border: 1px solid var(--outline); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.3px; margin-right: 4px; margin-bottom: 4px; background: var(--retro-2); color: var(--paper); }
        .badge.palette-badge { background: linear-gradient(135deg, var(--retro-3) 0%, var(--retro-2) 100%); border: 1px solid var(--outline); text-transform: uppercase; letter-spacing: 0.5px; }
        .badge.palette-ascii { font-family: "VT323", monospace; font-size: 0.9rem; background: var(--retro-1); color: var(--proto-1); text-shadow: 0 0 4px var(--proto-1); animation: pulse 2s ease-in-out infinite; }
        @keyframes pulse { 0%, 100% { opacity: 0.8; } 50% { opacity: 1; text-shadow: 0 0 8px var(--proto-1); } }
        .badge.open { background: var(--proto-1); color: var(--retro-black); border-color: var(--retro-black); }
        .badge.closed { background: var(--proto-6); color: var(--retro-13); border-color: var(--outline); }
