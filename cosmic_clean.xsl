    (function portSectionControls() {
        var matrix = document.getElementById("port-matrix");
        if (!matrix) return;
        var hideBtn = document.getElementById("toggle-likely-closed");
        var expandBtn = document.getElementById("expand-all-ports");
        var collapseBtn = document.getElementById("collapse-all-ports");
        var hideLikely = false;
        function isPortClickInteractive(target) {
            if (!target) return true;
            return !!target.closest("button, input, select, textarea, label, a, code, pre, .inline-cell-editor, [contenteditable='true'], .port-main-actions, .subrow-controls, .subrow-drag-handle");
        }

        function isLikelyClosed(tb) {
            var st = (tb.getAttribute("data-port-state") || "").toLowerCase();
            return st !== "open";
        }
        function setPortCollapsed(tb, collapsed) {
            tb.classList.toggle("port-collapsed", collapsed);
            var first = tb.querySelector("tr");
            if (first) {
                var indicator = first.querySelector("[data-port-state-indicator]");
                if (indicator) indicator.textContent = collapsed ? "+" : "−";
            }
        }
        function applyHideLikely() {
            matrix.querySelectorAll("tbody.port-block").forEach(function (tb) {
                tb.classList.toggle("port-hidden-likely", hideLikely && isLikelyClosed(tb));
            });
            if (hideBtn) hideBtn.textContent = hideLikely ? "Show Likely Closed/Mixed" : "Hide Likely Closed/Mixed";
        }
        matrix.querySelectorAll("tbody.port-block").forEach(function (tb) {
            if (isLikelyClosed(tb)) setPortCollapsed(tb, true);
            var headerRow = tb.querySelector("tr");
            if (headerRow) {
                headerRow.addEventListener("click", function (evt) {
                    if (isPortClickInteractive(evt.target)) return;
                    setPortCollapsed(tb, !tb.classList.contains("port-collapsed"));
                });
            }
        });
        if (hideBtn) hideBtn.addEventListener("click", function () { hideLikely = !hideLikely; applyHideLikely(); });
        if (expandBtn) expandBtn.addEventListener("click", function () {
            matrix.querySelectorAll("tbody.port-block").forEach(function (tb) { setPortCollapsed(tb, false); });
        });
        if (collapseBtn) collapseBtn.addEventListener("click", function () {
            matrix.querySelectorAll("tbody.port-block").forEach(function (tb) { setPortCollapsed(tb, true); });
        });
        applyHideLikely();
        (function portUserHide() {
            var STORAGE_HIDDEN_PORTS = "cosmicAnal:v1:hiddenPortKeys";
            function loadPorts() {
                try { return JSON.parse(localStorage.getItem(STORAGE_HIDDEN_PORTS) || "[]"); } catch (e) { return []; }
            }
            function savePorts(arr) {
                try { localStorage.setItem(STORAGE_HIDDEN_PORTS, JSON.stringify(arr)); } catch (e) {}
            }
            function applyPortHidden() {
                var hidden = loadPorts();
                matrix.querySelectorAll("tbody.port-block").forEach(function (tb) {
                    var k = tb.getAttribute("data-port-key");
                    if (k && hidden.indexOf(k) >= 0) tb.classList.add("port-user-hidden");
                    else tb.classList.remove("port-user-hidden");
                });
            }
            matrix.querySelectorAll("[data-port-remove]").forEach(function (btn) {
                btn.addEventListener("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var k = btn.getAttribute("data-port-remove");
                    if (!k) return;
                    var h = loadPorts();
                    if (h.indexOf(k) < 0) { h.push(k); savePorts(h); }
                    applyPortHidden();
                });
            });
            matrix.querySelectorAll("[data-port-reset]").forEach(function (btn) {
                btn.addEventListener("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var key = btn.getAttribute("data-port-reset");
                    if (!key) return;
                    var hasNotes = false;
                    try {
                        hasNotes = !!localStorage.getItem("cosmicAnal:v1:portExtra:" + key)
                            || localStorageKeys().some(function (k) {
                                if (!k) return false;
                                if (k.indexOf("cosmicAnal:v1:cmdNote:" + key + "|") === 0) return true;
                                if (k.indexOf("cosmicAnal:v1:cmdExtra:" + key + "|") === 0) return true;
                                return k === ("cosmicAnal:v1:" + key);
                            });
                    } catch (err) {}
                    var keepNotes = true;
                    if (hasNotes) keepNotes = window.confirm("Notes found for this port module. Click OK to keep notes, or Cancel to reset notes too.");

                    var hidden = loadPorts().filter(function (x) { return x !== key; });
                    savePorts(hidden);

                    if (!keepNotes) {
                        try { localStorage.removeItem("cosmicAnal:v1:portExtra:" + key); } catch (err2) {}
                        localStorageKeys().forEach(function (k) {
                            if (!k) return;
                            if (k.indexOf("cosmicAnal:v1:cmdNote:" + key + "|") === 0) try { localStorage.removeItem(k); } catch (err3) {}
                            if (k.indexOf("cosmicAnal:v1:cmdExtra:" + key + "|") === 0) try { localStorage.removeItem(k); } catch (err4) {}
                            if (k === ("cosmicAnal:v1:" + key)) try { localStorage.removeItem(k); } catch (err5) {}
                        });
                    }
                    applyPortHidden();
                    window.location.reload();
                });
            });
            var rp = document.getElementById("restore-hidden-ports");
            if (rp) rp.addEventListener("click", function () { savePorts([]); applyPortHidden(); });
            applyPortHidden();
        })();
    })();
    (function portMatrixDragSort() {
