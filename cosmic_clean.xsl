        .port-controls { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
        .port-subrow td { background: var(--retro-0) !important; padding: 8px 10px 10px 24px; border-color: var(--retro-2); }
        .port-subrow details { margin-top: 0; border: 1px solid var(--outline); background: var(--bg-panel); }
        
        .analysis-note-inline-wrap { margin-top: 8px; margin-bottom: 8px; }
