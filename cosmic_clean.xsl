    (function readabilityToggle() {
        var btn = document.getElementById("readability-toggle");
        var key = "cosmicAnal:v1:readability";
        var root = document.documentElement;
        var enabled = true;
        try {
            var saved = localStorage.getItem(key);
            if (saved === "off") enabled = false;
        } catch (e) {}
        function render() {
            root.classList.toggle("readability-on", enabled);
            if (btn) btn.textContent = enabled ? "Readability: On" : "Readability: Off";
            applyReadability();
        }
        if (btn) {
            btn.addEventListener("click", function () {
                enabled = !enabled;
                try { localStorage.setItem(key, enabled ? "on" : "off"); } catch (e) {}
                render();
            });
        }
        render();
    })();
