                    <option value="sloth">Sloth</option>
                </select>
                <div style="margin-top: 8px;">
                    <span id="palette-name" class="badge palette-badge" style="display:none;"></span>
                    <span id="palette-ascii" class="badge palette-ascii" style="display:none;"></span>
                </div>
            </div>
        </div>

        <div class="box-level-1 section-edit-locked" style="margin:0;" id="section-ports">
                <div class="box-header-actions">
                    <span class="box-drag-handle" title="Drag to reorder section">⋮⋮</span>
                    <button type="button" class="box-btn-reset" data-section-reset="section-ports" title="Reset this section to default">↺</button>
                    <button type="button" class="box-btn-remove" title="Remove section">×</button>
                </div>
                <h2>Port Matrix</h2>
                <div class="port-controls">
                <button type="button" class="section-edit-btn section-edit-toggle" data-section="section-ports">Edit</button>
                <span class="section-edit-hint" style="margin-right: 12px;">Locked</span>
                <button type="button" class="report-link-action" id="toggle-likely-closed">Hide Likely Closed/Mixed</button>
                <button type="button" class="report-link-action" id="expand-all-ports">Expand all ports</button>
                <button type="button" class="report-link-action" id="collapse-all-ports">Collapse all ports</button>
                <button type="button" class="report-link-action" id="restore-hidden-ports" title="Show ports you removed from this view">Restore removed ports</button>
                <button type="button" class="report-link-action" id="restore-hidden-cmd-rows" title="Show hidden per-scan rows under ports">Restore command rows</button>
            </div>
            <table id="port-matrix">
                <thead><tr><th data-sort="port">Port</th><th>Status</th><th data-sort="service">Service</th><th>Version</th><th>Product</th><th>Extra Info</th></tr></thead>
                <xsl:for-each select="/nmaprun/host/ports/port">
                    <xsl:variable name="hostip" select="../../address/@addr"/>
                    <xsl:variable name="akey" select="concat($hostip, '|', @protocol, '|', @portid)"/>
                    <xsl:variable name="rowclass">
                        <xsl:choose><xsl:when test="state/@state = 'open'">row-open</xsl:when><xsl:when test="state/@state = 'filtered'">row-filtered</xsl:when><xsl:when test="contains(state/@state, 'filtered')">row-mixed</xsl:when><xsl:otherwise>row-closed</xsl:otherwise></xsl:choose>
                    </xsl:variable>
                    <xsl:variable name="port_proto" select="translate(@protocol, 'TCPUD', 'tcpud')"/>
                    <xsl:variable name="relevant_scans" select="/nmaprun/cosmiccommands/scan[($port_proto='udp' and contains(@args, '-sU')) or ($port_proto='tcp' and not(contains(@args, '-sU')))]"/>
                    <xsl:variable name="portid" select="@portid"/>

                    <tbody class="port-block protocol-{@protocol}" data-port="{$portid}" data-service="{service/@name}" data-port-state="{state/@state}" data-port-key="{$akey}" draggable="true">
                    <tr class="{$rowclass}">
                        <td><strong><xsl:value-of select="@portid"/></strong><span class="badge badge-muted" data-port-state-indicator="" style="margin-left:6px;">−</span><xsl:choose><xsl:when test="@protocol='tcp'"><span class="badge proto-tcp" style="margin-left:6px;">TCP</span></xsl:when><xsl:otherwise><span class="badge proto-udp" style="margin-left:6px;">UDP</span></xsl:otherwise></xsl:choose><span class="port-main-actions"><button type="button" class="btn-subtle-remove" data-port-remove="{$akey}" title="Hide this port block (saved in browser)">×</button><button type="button" class="subrow-btn-reset" data-port-reset="{$akey}" title="Reset this port module to default">↺</button></span></td>
                        <td><xsl:choose><xsl:when test="state/@state='open'"><span class="badge open">OPEN</span></xsl:when><xsl:when test="contains(state/@state, 'filtered')"><span class="badge teal">MIXED</span></xsl:when><xsl:otherwise><span class="badge closed">CLOSED</span></xsl:otherwise></xsl:choose></td>
                        <td><xsl:value-of select="service/@name"/></td>
                        <td><xsl:value-of select="service/@version"/></td>
                        <td><xsl:value-of select="service/@product"/></td>
                        <td>
                            <div class="inline-cell-editor" contenteditable="true" data-port-extra-input="{$akey}" data-placeholder="Extra info (editable)..."><xsl:value-of select="service/@extrainfo"/></div>
                        </td>
                    </tr>
                    <tr class="port-subrow category-analyst" data-subrow-id="analyst">
                        <td colspan="6">
                            <details class="analysis-details" data-analysis-key="{$akey}">
                                <summary><span class="subline-title">Analyst note</span><span class="badge anal badge-hidden" data-analysis-flag="{$akey}">ANAL</span><span class="analysis-preview" data-analysis-preview="{$akey}"></span></summary>
                                <div class="analysis-note-inline-wrap" data-analysis-display-wrap="{$akey}">
                                    <button type="button" class="report-btn analysis-add-btn" data-analysis-add="{$akey}">Add analyst note</button>
                                    <div class="inline-cell-editor analysis-inline-editor" contenteditable="true" data-analysis-input="{$akey}" data-placeholder="Click and type analyst note..."></div>
                                </div>
                            </details>
                        </td>
                    </tr>
                    <xsl:if test="service/@servicefp"><tr class="port-subrow category-fingerprint" data-subrow-id="fingerprint"><td colspan="6"><details><summary><span class="subline-title">Service fingerprint</span></summary><pre><xsl:value-of select="service/@servicefp"/></pre></details></td></tr></xsl:if>
                    <xsl:if test="script"><tr class="port-subrow category-scripts" data-subrow-id="scripts"><td colspan="6"><details><summary><span class="subline-title">Port scripts</span></summary><xsl:for-each select="script"><details><summary><xsl:value-of select="@id"/></summary><pre><xsl:value-of select="@output"/></pre></details></xsl:for-each></details></td></tr></xsl:if>
                    <xsl:if test="count($relevant_scans) > 0">
                        <tr class="port-subrow category-commands" data-subrow-id="commands">
                            <td colspan="6">
                                <details>
                                    <summary>
                                        <span class="subline-title">Commands</span>
                                        <xsl:for-each select="$relevant_scans">
                                            <code class="cmd-preview"><xsl:value-of select="@flags"/></code>
                                        </xsl:for-each>
                                    </summary>
                                    <table class="cmd-table">
                                        <thead>
                                            <tr>
                                                <th>Tool</th>
                                                <th>Flags</th>
                                                <th>Output</th>
                                                <th>Notes</th>
                                                <th>Extra Info</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <xsl:for-each select="$relevant_scans">
                                                <xsl:variable name="scan_key" select="concat($akey, '|', @start, '|', position())"/>
                                                <xsl:variable name="port_result" select="result[@portid=$portid and @protocol=$port_proto][1]"/>
                                                <tr>
                                                    <td><button type="button" class="btn-subtle-remove" data-cmd-remove="{$scan_key}" title="Hide this scan row">×</button> <xsl:text> </xsl:text><xsl:value-of select="@tool"/></td>
                                                    <td>
                                                        <code>
                                                            <xsl:choose>
                                                                <xsl:when test="string-length(@flags) &gt; 0"><xsl:value-of select="@flags"/></xsl:when>
                                                                <xsl:otherwise><xsl:value-of select="@args"/></xsl:otherwise>
                                                            </xsl:choose>
                                                        </code>
                                                    </td>
                                                    <td class="cmd-inline-output">
                                                        <xsl:choose>
                                                            <xsl:when test="$port_result">
                                                                <pre>state=<xsl:value-of select="$port_result/@state"/> reason=<xsl:value-of select="$port_result/@reason"/>
service=<xsl:value-of select="$port_result/@service"/> version=<xsl:value-of select="$port_result/@version"/> product=<xsl:value-of select="$port_result/@product"/></pre>
                                                            </xsl:when>
                                                            <xsl:otherwise>
                                                                <pre>nothing (no direct result for this port in this scan)</pre>
                                                            </xsl:otherwise>
                                                        </xsl:choose>
                                                    </td>
                                                    <td>
                                                        <div class="inline-cell-editor" contenteditable="true" data-cmd-note="{$scan_key}" data-placeholder="Note (editable)..."></div>
                                                    </td>
                                                    <td>
                                                        <div class="inline-cell-editor" contenteditable="true" data-cmd-extra="{$scan_key}" data-placeholder="Extra info (editable)..."></div>
                                                    </td>
                                                </tr>
                                            </xsl:for-each>
