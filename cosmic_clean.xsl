        }

        /* Section-level edit locking */
        .section-edit-locked { }
        .section-edit-locked .inline-cell-editor,
        .section-edit-locked .evidence-inline-edit,
        .section-edit-locked .evidence-raw-edit,
        .section-edit-locked [contenteditable="true"]:not(.always-editable) {
