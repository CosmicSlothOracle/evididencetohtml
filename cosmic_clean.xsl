        }
        document.addEventListener('mousedown', function(e) {
            const editable = pickEditableTarget(e.target);
            if (editable) {
                showEditor(editable);
            } else if (!e.target.closest('#global-editor')) {
                editor.classList.remove('active');
            }
        });
        document.addEventListener('focusin', function (e) {
            const editable = pickEditableTarget(e.target);
            if (editable && !editor.classList.contains("active")) {
                showEditor(editable);
            } else if (editable) {
                currentTarget = editable;
                captureSelection();
            }
        });
        document.addEventListener("mouseup", function () { captureSelection(); });
        document.addEventListener("keyup", function () { captureSelection(); });
        document.addEventListener("selectionchange", function () { captureSelection(); });
        if (editor) editor.addEventListener("mousedown", function (e) {
            // Prevent editor from stealing focus, but allow button clicks
            if (e.target.tagName !== 'BUTTON' && !e.target.closest('button')) {
                e.preventDefault();
            }
            captureSelection();
        });

        document.querySelectorAll('[data-edit-cmd]').forEach(function(btn) {
            btn.addEventListener('mousedown', function(e) {
                // Prevent focus loss
                e.preventDefault();
            });
            btn.addEventListener('click', function() {
                var cmd = btn.getAttribute('data-edit-cmd');
                if (!cmd) return;
                applyEditorCommand(cmd, null);
            });
        });

        // Color selection is now handled by palette swatches (click for text color, right-click for highlight)

        document.addEventListener("keydown", function (e) {
            if (!currentTarget) return;
            var mod = e.ctrlKey || e.metaKey;
            if (!mod) return;
            var key = (e.key || "").toLowerCase();
            var isUndo = (key === "z" && !e.shiftKey);
            var isRedo = (key === "y") || (key === "z" && e.shiftKey);
            if (!isUndo && !isRedo) return;
            var active = document.activeElement;
            var withinCurrent = active === currentTarget || (currentTarget.contains && active && currentTarget.contains(active));
            var withinEditor = !!(active && active.closest && active.closest("#global-editor"));
            if (!withinCurrent && !withinEditor) return;
            e.preventDefault();
            applyEditorCommand(isUndo ? "undo" : "redo", null);
        });

        if (editorOpacity) editorOpacity.addEventListener('input', function(e) {
            if (currentTarget) {
                currentTarget.style.opacity = e.target.value / 100;
            }
        });

        if (editorClose) editorClose.addEventListener('click', function() {
            editor.classList.remove('active');
        });

        // PALETTE COLOR SWATCHES IN EDITOR - Dynamic theme color extraction
        (function injectPaletteColors() {
            var paletteContainer = document.getElementById("editor-palette-colors");
            if (!paletteContainer) return;

            // All possible CSS variable prefixes to scan for colors
            var varPrefixes = [
                "--retro-black", "--paper", "--cream",
                "--retro-0", "--retro-1", "--retro-2", "--retro-3", "--retro-4",
                "--retro-5", "--retro-6", "--retro-7", "--retro-8", "--retro-9",
                "--retro-10", "--retro-11", "--retro-12", "--retro-13", "--retro-14",
                "--proto-1", "--proto-2", "--proto-3", "--proto-4", "--proto-5", "--proto-6",
                "--proto-7", "--proto-8", "--extra-1", "--extra-2", "--extra-3",
                "--extra-4", "--extra-5", "--extra-6", "--accent", "--ok", "--warn", "--bad",
                "--cat-evidence", "--cat-fingerprint", "--cat-commands", "--cat-scripts", "--cat-analyst",
                "--text-main", "--text-muted", "--border", "--outline", "--emph",
                "--bg-main", "--bg-panel", "--bg-card"
            ];

            // Theme-specific extended variables (e.g., for NES, LSD, Cumorder69)
            var extendedPrefixes = [];
            for (var i = 31; i <= 64; i++) {
                extendedPrefixes.push("--nes-p" + i);
                extendedPrefixes.push("--sms-p" + i);
                extendedPrefixes.push("--lsd-p" + i);
                extendedPrefixes.push("--c69-p" + i);
            }
            varPrefixes = varPrefixes.concat(extendedPrefixes);

            function getUniqueColors() {
                var style = getComputedStyle(document.documentElement);
                var colors = [];
                var seen = {};

                // Helper to normalize color for comparison
                function normalizeColor(c) {
                    if (!c) return "";
                    c = c.trim().toLowerCase();
                    // Convert named colors to hex for comparison
                    if (c === "black") return "#000000";
                    if (c === "white") return "#ffffff";
                    return c;
                }

                // Scan all defined CSS variables
                varPrefixes.forEach(function(v) {
                    var color = style.getPropertyValue(v).trim();
                    if (!color) return;

                    var normalized = normalizeColor(color);
                    if (!normalized || seen[normalized]) return;

                    seen[normalized] = true;
                    colors.push({ var: v, color: color, normalized: normalized });
                });

                // Always ensure black and white are available
                if (!seen["#000000"] && !seen["black"]) {
                    colors.push({ var: "--retro-black", color: "#000000", normalized: "#000000" });
                }
                if (!seen["#ffffff"] && !seen["white"]) {
                    // Find a light color to use as white, or add pure white
                    var hasLight = colors.some(function(c) {
                        return c.normalized.match(/^#(f|e|d|c)/);
                    });
                    if (!hasLight) {
                        colors.push({ var: "--paper", color: "#ffffff", normalized: "#ffffff" });
                    }
                }

                // Sort: dark first, then light
                colors.sort(function(a, b) {
                    // Simple heuristic: darker colors come first
                    var getLuma = function(c) {
                        var hex = c.replace("#", "");
                        if (hex.length === 3) hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
                        var r = parseInt(hex.substr(0, 2), 16) || 0;
                        var g = parseInt(hex.substr(2, 2), 16) || 0;
                        var b = parseInt(hex.substr(4, 2), 16) || 0;
                        return (0.299 * r + 0.587 * g + 0.114 * b);
                    };
                    return getLuma(a.color) - getLuma(b.color);
                });

                return colors;
            }

            function updateSwatches() {
                paletteContainer.innerHTML = "";
                var colors = getUniqueColors();

                colors.forEach(function(item) {
                    var dot = document.createElement("div");
                    dot.className = "editor-palette-dot";
                    dot.style.background = item.color;
                    dot.title = item.var + ": " + item.color;
                    dot.setAttribute("data-palette-color", item.color);
                    paletteContainer.appendChild(dot);
                });
            }

            updateSwatches();

            var obs = new MutationObserver(function (muts) {
                muts.forEach(function (m) {
                    if (m.attributeName === "data-theme" || m.attributeName === "data-palette") {
                        setTimeout(updateSwatches, 50);
                    }
                });
            });
            obs.observe(document.documentElement, { attributes: true });

            // Save selection before entering palette area
            var savedRange = null;
            paletteContainer.addEventListener("mouseenter", function() {
                if (!currentTarget) return;
                var sel = window.getSelection();
                if (sel && sel.rangeCount > 0) {
                    savedRange = sel.getRangeAt(0);
                }
            });

            paletteContainer.addEventListener("mousedown", function(e) {
                // Prevent losing focus from editable element
                e.preventDefault();
                // Save selection state
                if (currentTarget) {
                    currentTarget.focus();
                    var sel = window.getSelection();
                    if (sel && sel.rangeCount > 0) {
                        savedRange = sel.getRangeAt(0).cloneRange();
                    }
                }
            });

            paletteContainer.addEventListener("click", function (e) {
                var dot = e.target.closest(".editor-palette-dot");
                if (!dot) return;
                e.preventDefault();
                e.stopPropagation();

                var color = dot.getAttribute("data-palette-color");
                if (!color || !currentTarget) return;

                // Restore focus and selection
                currentTarget.focus();
                var sel = window.getSelection();
                sel.removeAllRanges();
                if (savedRange) {
                    sel.addRange(savedRange);
                } else if (sel.rangeCount > 0) {
                    // Use current selection if available
                }

                document.execCommand("foreColor", false, color);
            });

            paletteContainer.addEventListener("contextmenu", function (e) {
                var dot = e.target.closest(".editor-palette-dot");
                if (!dot) return;
                e.preventDefault();
                e.stopPropagation();

                var color = dot.getAttribute("data-palette-color");
                if (!color || !currentTarget) return;

                // Restore focus and selection
                currentTarget.focus();
                var sel = window.getSelection();
                sel.removeAllRanges();
                if (savedRange) {
                    sel.addRange(savedRange);
                }

                document.execCommand("hiliteColor", false, color);
            });
        })();

        // GLOBAL EDIT TOGGLE
        (function globalEditToggle() {
            var toggleBtn = document.getElementById("global-edit-toggle");
            if (!toggleBtn) return;
            var STORAGE = "cosmicAnal:v1:globalEditLock";
            var locked = false;
            try { locked = localStorage.getItem(STORAGE) === "locked"; } catch (e) {}
            function apply() {
                document.body.classList.toggle("cosmic-edit-locked", locked);
                toggleBtn.classList.toggle("btn-active", !locked);
                toggleBtn.title = locked ? "Editing Locked - Click to Unlock" : "Editing Enabled - Click to Lock";
            }
            apply();
            toggleBtn.addEventListener("click", function () {
                locked = !locked;
                try { localStorage.setItem(STORAGE, locked ? "locked" : "unlocked"); } catch (e) {}
                apply();
            });
        })();

        // SECTION-LEVEL EDIT TOGGLES
        (function sectionEditToggles() {
            var STORAGE_PREFIX = "cosmicAnal:v1:sectionEdit:";

            document.querySelectorAll('.section-edit-toggle').forEach(function(btn) {
                var sectionId = btn.getAttribute('data-section');
                if (!sectionId) return;

                var section = document.getElementById(sectionId);
                if (!section) return;

                var hint = btn.parentElement.querySelector('.section-edit-hint');
                var STORAGE = STORAGE_PREFIX + sectionId;
                var isEditing = false;

                // Load saved state
                try {
                    var saved = localStorage.getItem(STORAGE);
                    isEditing = saved === "editing";
                } catch (e) {}

                function apply() {
                    if (isEditing) {
                        section.classList.remove('section-edit-locked');
                        btn.textContent = "Lock";
                        btn.classList.add('editing');
                        if (hint) hint.textContent = "Editing enabled - select text to edit";
                    } else {
                        section.classList.add('section-edit-locked');
                        btn.textContent = "Edit";
                        btn.classList.remove('editing');
                        if (hint) hint.textContent = "Locked";
                    }
                }

                apply();

                btn.addEventListener('click', function() {
                    isEditing = !isEditing;
                    try {
                        localStorage.setItem(STORAGE, isEditing ? "editing" : "locked");
                    } catch (e) {}
                    apply();
                });
            });
        })();

        // 3. SECTION RESTORE LOGIC
        const restoreZone = document.getElementById('section-restore-zone');
        const hiddenList = document.getElementById('hidden-sections-list');

        function updateRestoreZone() {
            const allBoxes = Array.from(document.querySelectorAll('.box-level-1, .overview-16x9'));
            const hidden = allBoxes.filter(function(b) { return b.style.display === 'none'; });
            if (!hiddenList) return;
            hiddenList.innerHTML = '';
            if (hidden.length > 0) {
                if (restoreZone) restoreZone.style.display = 'block';
                hidden.forEach(function(b) {
                    const hText = b.querySelector('h1, h2, h3');
                    let name = hText ? hText.innerText : b.id;
                    if (b.id === 'section-overview') name = "Overview Box";
                    const btn = document.createElement('button');
                    btn.className = 'report-btn';
                    btn.style.marginRight = '5px';
                    btn.innerText = '+ ' + name;
                    btn.onclick = function() {
                        b.style.display = 'block';
                        saveSectionOrder();
                        updateRestoreZone();
                    };
                    hiddenList.appendChild(btn);
                });
            } else {
                if (restoreZone) restoreZone.style.display = 'none';
            }
        }

        // Intercept remove buttons
        document.querySelectorAll('.box-btn-remove').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const box = btn.closest('.box-level-1, .overview-16x9');
                if (box) {
                    box.style.display = 'none';
                    saveSectionOrder();
                    updateRestoreZone();
                }
            });
        });
        document.querySelectorAll('[data-section-reset]').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                var id = btn.getAttribute('data-section-reset');
                if (!id) return;
                resetSectionToDefault(id);
            });
        });

        loadSectionOrder();
        updateRestoreZone();
    })();
})();
]]></script>
</body>
</html>
</xsl:template>
</xsl:stylesheet>
