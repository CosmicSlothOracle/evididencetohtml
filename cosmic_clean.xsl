        .analysis-note-inline-wrap.analysis-priority { border: 2px solid var(--note-signal); background: rgba(255, 62, 62, 0.05); }

        .subline-title { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.6px; color: var(--cream); margin-right: 10px; padding: 4px 0; }
        .cmd-preview { display: inline-block; font-family: "Space Mono", monospace; font-size: 0.78rem; color: var(--paper); opacity: 0.85; background: rgba(0,0,0,0.2); padding: 1px 4px; border-radius: 3px; margin-left: 6px; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; }

        .port-subrow.category-evidence .subline-title { color: var(--cat-evidence); text-shadow: 1px 1px 0px var(--retro-black); }
        .port-subrow.category-evidence details { border: 1px solid var(--cat-evidence); border-left-width: 4px; }
        .port-subrow.category-fingerprint .subline-title { color: var(--cat-fingerprint); text-shadow: 1px 1px 0px var(--retro-black); }
        .port-subrow.category-fingerprint details { border: 1px solid var(--cat-fingerprint); border-left-width: 4px; }
        .port-subrow.category-commands .subline-title { color: var(--cat-commands); text-shadow: 1px 1px 0px var(--retro-black); }
        .port-subrow.category-commands details { border: 1px solid var(--cat-commands); border-left-width: 4px; }
        .port-subrow.category-scripts .subline-title { color: var(--cat-scripts); text-shadow: 1px 1px 0px var(--retro-black); }
        .port-subrow.category-scripts details { border: 1px solid var(--cat-scripts); border-left-width: 4px; }
        .port-subrow.category-analyst .subline-title { color: var(--cat-analyst); text-shadow: 1px 1px 0px var(--retro-black); }
        .port-subrow.category-analyst details { border: 1px solid var(--cat-analyst); border-left-width: 4px; }

        details { border: 1px solid var(--retro-2); border-radius: 6px; padding: 8px 10px; margin-top: 8px; background: var(--retro-1); }
        summary { cursor: pointer; font-weight: 700; color: var(--paper); font-size: 0.88rem; text-decoration-thickness: 1px; text-underline-offset: 2px; }
        .hint-text { color: var(--retro-10); font-size: 0.8rem; margin-top: 6px; }
        pre, code { white-space: pre-wrap; word-break: break-word; font-family: "Space Mono", monospace; font-size: 0.78rem; background: var(--retro-0); border: 1px solid var(--outline); border-radius: 4px; padding: 10px; color: var(--retro-11); display: block; }

        .report-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; }
        .report-btn { border: 2px solid var(--outline); background: var(--retro-2); color: var(--paper); border-radius: 6px; padding: 8px 12px; font-family: "Space Mono", monospace; font-size: 0.84rem; cursor: pointer; transition: all 0.1s ease; text-shadow: 0 1px 0 rgba(0,0,0,0.35); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.04); }
        .report-btn:hover { background: var(--retro-3); color: var(--retro-14); transform: translateY(-1px); }
        .report-btn.active { background: var(--note-signal); color: var(--retro-black); border-color: var(--retro-black); }
        .report-link-action { border: none; padding: 0; min-width: unset; width: auto; background: transparent; color: var(--ui-link, var(--accent)); font-size: 0.79rem; text-decoration: underline; text-decoration-style: dotted; text-underline-offset: 2px; box-shadow: none; }
        .report-link-action:hover { background: transparent; color: var(--paper); transform: none; }
