        body { margin: 0; padding: 16px; background: linear-gradient(180deg, var(--retro-1) 0%, var(--retro-0) 50%, var(--retro-black) 100%); color: var(--text-main); font-family: "Space Mono", "VT323", monospace; line-height: 1.45; font-size: 14px; }
        [data-theme="lsd"] body { background: linear-gradient(180deg, var(--retro-0) 0%, var(--lsd-p31) 2%, var(--lsd-p35) 9%, var(--lsd-p40) 18%, var(--lsd-p45) 28%, var(--lsd-p50) 38%, var(--lsd-p55) 48%, var(--lsd-p60) 58%, var(--lsd-p64) 95%, var(--retro-black) 100%); }
        [data-theme="nes"] body { background: linear-gradient(180deg, var(--retro-0) 0%, var(--nes-p31) 5%, var(--nes-p35) 20%, var(--nes-p40) 30%, var(--nes-p45) 40%, var(--nes-p50) 70%, var(--nes-p52) 85%, var(--retro-black) 100%); }
        [data-theme="sms"] body { background: linear-gradient(180deg, var(--retro-0) 0%, var(--retro-2) 30%, var(--retro-3) 60%, var(--retro-4) 85%, var(--retro-black) 100%); }

        .container { width: 100%; max-width: 1920px; margin: 0 auto; }
