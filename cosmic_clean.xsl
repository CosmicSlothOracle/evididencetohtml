    </xsl:for-each>
</div>

<script><![CDATA[
(function () {
    function storageKey(rawKey) { return "cosmicAnal:v1:" + rawKey; }
    function readRecord(rawKey) {
        try {
            var raw = localStorage.getItem(storageKey(rawKey)) || "";
            if (!raw) return { name: "", note: "", updated: "", size: "0.84rem", priority: false };
            try {
                var parsed = JSON.parse(raw);
                return { name: parsed.name || "", note: parsed.note || "", updated: parsed.updated || "", size: parsed.size || "0.84rem", priority: !!parsed.priority };
            } catch (jsonErr) { return { name: "", note: raw, updated: "", size: "0.84rem", priority: false }; }
        } catch (e) { return { name: "", note: "", updated: "", size: "0.84rem", priority: false }; }
    }
    function writeRecord(rawKey, record) { try { if (record.note && record.note.trim().length > 0) { localStorage.setItem(storageKey(rawKey), JSON.stringify(record)); } else { localStorage.removeItem(storageKey(rawKey)); } } catch (e) {} }
    function stripHtml(html) { if (!html) return ""; var d = document.createElement("div"); d.innerHTML = html; return (d.textContent || d.innerText || "").trim(); }
    function previewText(text) { if (!text) return ""; var plain = stripHtml(text); var normalized = plain.replace(/\s+/g, " ").trim(); if (normalized.length <= 120) return normalized; return normalized.slice(0, 120) + "..."; }
    function replaceEvidenceRefsInNode(root) {
        if (!root) return;
        var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
        var nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);
        nodes.forEach(function (node) {
            if (!node || !node.nodeValue) return;
            if (node.parentElement && (node.parentElement.closest(".evidence-ref-link, a, button, textarea, pre, code"))) return;
            var text = node.nodeValue;
            if (!/\bE\d+\b/i.test(text)) return;
            var frag = document.createDocumentFragment();
            var rx = /\bE(\d+)\b/ig;
            var last = 0;
            var m;
            while ((m = rx.exec(text)) !== null) {
                if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
                var idx = parseInt(m[1], 10);
                var targetExists = !!document.querySelector('details[data-evidence-index="' + idx + '"]');
                if (targetExists) {
                    var btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "evidence-ref-link";
                    btn.setAttribute("data-evidence-ref", String(idx));
                    btn.setAttribute("title", "Jump to evidence E" + idx);
                    btn.textContent = "E" + idx;
                    frag.appendChild(btn);
                } else {
                    frag.appendChild(document.createTextNode(m[0]));
                }
                last = m.index + m[0].length;
            }
            if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
            if (node.parentNode) node.parentNode.replaceChild(frag, node);
        });
    }
    function revealEvidenceByIndex(index) {
        if (!index || index < 1) return;
        var target = document.querySelector('details[data-evidence-index="' + index + '"]');
        if (!target) return;
        var section = document.getElementById("section-evidence");
        if (section) section.style.display = "block";
        try {
            var hiddenSectionsRaw = localStorage.getItem("cosmic:hiddenSections") || "[]";
            var hiddenSections = JSON.parse(hiddenSectionsRaw);
            if (Array.isArray(hiddenSections)) {
                hiddenSections = hiddenSections.filter(function (id) { return id !== "section-evidence"; });
                localStorage.setItem("cosmic:hiddenSections", JSON.stringify(hiddenSections));
            }
        } catch (e) {}
        target.classList.remove("evidence-user-hidden");
        target.open = true;
        try {
            var hiddenEvidenceRaw = localStorage.getItem("cosmicAnal:v1:hiddenEvidenceKeys") || "[]";
            var hiddenEvidence = JSON.parse(hiddenEvidenceRaw);
            var k = target.getAttribute("data-evidence-key");
            if (k && Array.isArray(hiddenEvidence)) {
                hiddenEvidence = hiddenEvidence.filter(function (x) { return x !== k; });
                localStorage.setItem("cosmicAnal:v1:hiddenEvidenceKeys", JSON.stringify(hiddenEvidence));
            }
        } catch (e2) {}
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        target.classList.add("target-ping");
        setTimeout(function () { target.classList.remove("target-ping"); }, 1400);
    }
    document.addEventListener("click", function (evt) {
        var ref = evt.target && evt.target.closest ? evt.target.closest("[data-evidence-ref]") : null;
        if (!ref) return;
        evt.preventDefault();
        var idx = parseInt(ref.getAttribute("data-evidence-ref"), 10);
        if (!isNaN(idx)) revealEvidenceByIndex(idx);
    });
    function renderRecord(rawKey) {
        var record = readRecord(rawKey);
        var hasValue = !!(record.note && record.note.trim().length > 0);
