        details.evidence-block.target-ping { box-shadow: 0 0 0 2px var(--accent); }

        /* Readability lock: keeps contrast stable across all palettes/themes */
        :root {
            --ui-text-main: var(--paper);
            --ui-text-muted: var(--text-muted);
            --ui-heading: var(--paper);
            --ui-border: var(--outline);
            --ui-code-bg: var(--retro-0);
            --ui-code-text: var(--paper);
            --ui-th-bg: var(--retro-2);
            --ui-th-text: var(--paper);
            --ui-td-bg-a: var(--retro-1);
            --ui-td-bg-b: var(--retro-0);
            --on-proto-1: var(--retro-black);
            --on-proto-5: var(--retro-black);
            --on-proto-6: var(--paper);
            --on-extra-1: var(--paper);
            --on-extra-3: var(--retro-0);
            --ui-btn-bg: var(--retro-2);
            --ui-btn-fg: var(--paper);
            --ui-btn-border: var(--outline);
            --ui-btn-hover-bg: var(--retro-3);
            --ui-btn-hover-fg: var(--retro-14);
            --ui-btn-active-bg: var(--note-signal);
            --ui-btn-active-fg: var(--retro-black);
            --ui-subtle-btn-fg: var(--paper);
            --ui-subtle-btn-bg: transparent;
            --ui-link: var(--accent);
            --ui-focus-ring: var(--accent);
            --ui-summary-fg: var(--paper);
        }
        .readability-on body { color: var(--ui-text-main); }
        .readability-on h1, .readability-on h2, .readability-on h3 { color: var(--ui-heading); text-shadow: none; }
        .readability-on .hint-text, .readability-on .analysis-status, .readability-on .text-muted { color: var(--ui-text-muted); }
        .readability-on .metric-value { color: var(--ui-text-main); }
        .readability-on table { border-color: var(--ui-border); }
        .readability-on th { background: var(--ui-th-bg); color: var(--ui-th-text); border-color: var(--ui-border); }
        .readability-on td { background: var(--ui-td-bg-a); color: var(--ui-text-main); border-color: var(--ui-border); }
        .readability-on tr:nth-child(even) td { background: var(--ui-td-bg-b); }
        .readability-on pre, .readability-on code { background: var(--ui-code-bg); color: var(--ui-code-text); border-color: var(--ui-border); }
        .readability-on .badge.open { color: var(--on-proto-1); }
        .readability-on .badge.filtered { color: var(--on-proto-5); }
        .readability-on .badge.closed { color: var(--on-proto-6); }
        .readability-on .badge.proto-udp { color: var(--on-extra-1); }
        .readability-on .badge.proto-tcp { color: var(--on-extra-3); }
        .readability-on .report-btn,
        .readability-on .box-btn-reset,
        .readability-on .box-btn-remove,
        .readability-on .subrow-btn-reset,
        .readability-on .editor-tool-btn {
            background: var(--ui-btn-bg);
            color: var(--ui-btn-fg);
            border-color: var(--ui-btn-border);
            text-shadow: none;
        }
        .readability-on .report-btn:hover,
        .readability-on .box-btn-reset:hover,
        .readability-on .box-btn-remove:hover,
        .readability-on .subrow-btn-reset:hover,
        .readability-on .editor-tool-btn:hover {
            background: var(--ui-btn-hover-bg);
            color: var(--ui-btn-hover-fg);
            border-color: var(--ui-btn-border);
        }
        .readability-on .report-btn.active,
        .readability-on .editor-tool-btn.btn-active {
            background: var(--ui-btn-active-bg);
            color: var(--ui-btn-active-fg);
            border-color: var(--ui-btn-border);
        }
        .readability-on .btn-subtle-remove {
            color: var(--ui-subtle-btn-fg);
            background: var(--ui-subtle-btn-bg);
            border: 1px solid var(--ui-btn-border);
            opacity: 0.95;
        }
        .readability-on .btn-subtle-remove:hover {
            color: var(--ui-btn-hover-fg);
            background: var(--ui-btn-hover-bg);
        }
        .readability-on .inline-cell-editor,
        .readability-on .evidence-inline-edit,
        .readability-on .evidence-raw-edit {
            color: var(--ui-text-main);
            border-color: rgba(255,255,255,0.30);
            background: transparent;
        }
        .readability-on .inline-cell-editor:hover,
        .readability-on .evidence-inline-edit:hover,
        .readability-on .evidence-raw-edit:hover { border-color: rgba(255,255,255,0.85); }
        .readability-on .inline-cell-editor:focus,
        .readability-on .evidence-inline-edit:focus,
        .readability-on .evidence-raw-edit:focus {
            border-color: rgba(255,255,255,1);
            background: transparent;
        }
        .readability-on .evidence-ref-link {
            background: var(--ui-btn-bg);
            color: var(--ui-btn-fg);
            border-color: var(--ui-btn-border);
        }
        .readability-on .evidence-ref-link:hover {
            background: var(--ui-btn-hover-bg);
            color: var(--ui-btn-hover-fg);
        }
        .readability-on a,
        .readability-on .cosmic-report-footer a {
            color: var(--ui-link);
            text-decoration: underline;
            text-underline-offset: 2px;
            text-decoration-thickness: 2px;
        }
        .readability-on summary {
            color: var(--ui-summary-fg);
            text-decoration: underline;
            text-decoration-thickness: 1px;
            text-underline-offset: 2px;
        }
        .readability-on :focus-visible {
            outline: 2px solid var(--ui-focus-ring);
            outline-offset: 2px;
            border-radius: 4px;
        }

        .hero-card { display: flex; flex-direction: column; gap: 10px; align-items: stretch; height: 100%; overflow: hidden; }
        .hero-sloth-block { flex: 1 1 auto; min-height: 200px; display: flex; flex-direction: column; }
        .hero-note-block { flex: 0 0 auto; display: flex; flex-direction: column; }
        .hero-note-label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--retro-12); margin-bottom: 8px; }
        .hero-note-input { width: 100%; min-height: 100px; background: var(--retro-0); color: var(--paper); border: 2px solid var(--outline); border-radius: 8px; padding: 12px; font-family: "Space Mono", monospace; font-size: 0.86rem; resize: vertical; }
        .branding.ascii-editor {
            width: 100%;
            flex: 1;
            min-height: 220px;
            background: var(--hero-ascii-bg, rgba(0, 0, 0, 0.32));
            border: 1px solid var(--hero-ascii-border, var(--outline));
            outline: none;
            color: var(--hero-ascii-fg, var(--retro-14));
            overflow: auto;
            margin: 10px 0;
            padding: 10px;
            border-radius: 4px;
            white-space: pre;
            tab-size: 4;
            caret-color: var(--hero-ascii-fg, var(--retro-14));
        }
        .branding.ascii-editor:focus {
            border-color: var(--hero-ascii-border, var(--retro-10));
            box-shadow: inset 0 0 0 2px rgba(0,0,0,0.15);
        }

        /* ASCII Art - ensure sufficient contrast */
        pre[data-ascii-art-name] {
            font-family: "Courier New", "Space Mono", monospace;
            font-size: 12px;
            line-height: 1.2;
            color: #ffffff;
            background: rgba(0, 0, 0, 0.3);
            padding: 12px;
            border: 1px solid var(--outline);
            border-radius: 4px;
            overflow: auto;
            max-height: 400px;
            white-space: pre;
            word-wrap: normal;
        }

        /* Theme-specific ASCII adjustments for better visibility */
        [data-theme="hollow"] pre[data-ascii-art-name],
        [data-theme="default"] pre[data-ascii-art-name],
        [data-palette="hollow"] pre[data-ascii-art-name],
        [data-palette="default"] pre[data-ascii-art-name] {
            color: #e8e8e8;
            background: rgba(20, 20, 30, 0.5);
            text-shadow: 0 0 2px rgba(0, 0, 0, 0.8);
        }

        [data-theme="snail"] pre[data-ascii-art-name],
        [data-palette="extra_013"] pre[data-ascii-art-name],
        [data-theme="pulp-fiction"] pre[data-ascii-art-name],
        [data-palette="extra_014"] pre[data-ascii-art-name],
        [data-theme="jackie-brown"] pre[data-ascii-art-name],
        [data-palette="extra_015"] pre[data-ascii-art-name],
        [data-theme="death-proof"] pre[data-ascii-art-name],
        [data-palette="extra_016"] pre[data-ascii-art-name],
        [data-theme="4-rooms"] pre[data-ascii-art-name],
        [data-palette="extra_017"] pre[data-ascii-art-name],
        [data-theme="liveslowdiewhenever"] pre[data-ascii-art-name],
        [data-palette="extra_018"] pre[data-ascii-art-name] {
            color: #f0f0f0;
            background: rgba(10, 10, 20, 0.6);
            text-shadow: 0 0 1px rgba(255, 255, 255, 0.3);
        }

        /* Light theme ASCII */
        [data-theme="gameboy"] pre[data-ascii-art-name],
        [data-palette="gameboy"] pre[data-ascii-art-name],
        [data-theme="nes"] pre[data-ascii-art-name],
        [data-palette="nes"] pre[data-ascii-art-name],
        [data-theme="gbpocket"] pre[data-ascii-art-name],
        [data-palette="gbpocket"] pre[data-ascii-art-name] {
            color: #000000;
            background: rgba(200, 200, 200, 0.4);
            text-shadow: none;
        }

        /* Bright/saturated theme ASCII */
        [data-theme="snes"] pre[data-ascii-art-name],
        [data-palette="snes"] pre[data-ascii-art-name],
        [data-theme="genesis"] pre[data-ascii-art-name],
        [data-palette="genesis"] pre[data-ascii-art-name] {
            color: #ffffff;
            background: rgba(0, 0, 0, 0.5);
            text-shadow: 0 0 3px rgba(0, 0, 0, 0.9);
        }

        #port-matrix thead th { cursor: pointer; user-select: none; }
        #port-matrix thead th:hover { text-decoration: underline; color: var(--accent); }

        /* MODULAR CONTENT &amp; GLOBAL EDITOR */
        .cosmic-modular-container { display: flex; flex-direction: column; gap: 16px; }
        .box-level-1 { position: relative; transition: transform 0.2s, box-shadow 0.2s; }
        .box-level-1.dragging { opacity: 0.4; transform: scale(0.98); }
        .box-level-1.drag-over { border: 2px dashed var(--accent); background: rgba(var(--proto-1-rgb, 246, 205, 38), 0.05); }
        
        .box-header-actions { position: absolute; top: 10px; right: 10px; display: flex; gap: 8px; z-index: 10; opacity: 0.3; transition: opacity 0.2s; }
        .box-level-1:hover .box-header-actions { opacity: 1; }
        .box-drag-handle { display: none !important; }
        .box-btn-remove { padding: 4px 8px; background: var(--bad); color: #fff; border: 1px solid var(--outline); border-radius: 4px; cursor: pointer; }
        .box-btn-reset { padding: 4px 8px; background: var(--retro-3); color: var(--paper); border: 1px solid var(--outline); border-radius: 4px; cursor: pointer; }
        .box-btn-reset:hover { background: var(--retro-4); color: var(--retro-14); }
        .box-btn-add { margin: 10px 0; padding: 8px; border: 2px dashed var(--outline); background: rgba(0,0,0,0.1); color: var(--text-muted); cursor: pointer; text-align: center; border-radius: 8px; transition: all 0.2s; }
        .box-btn-add:hover { background: rgba(var(--proto-1-rgb, 246, 205, 38), 0.1); color: var(--paper); border-color: var(--accent); }

        .global-editor-panel {
            position: fixed; top: 20px; left: 50%; transform: translateX(-50%);
            background: var(--bg-panel); border: 3px solid var(--accent); border-radius: 12px;
            padding: 12px; display: none; flex-wrap: wrap; gap: 10px; align-items: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5); z-index: 9999;
            width: fit-content; max-width: 90vw; animation: editor-slide-in 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .analysis-inline-editor {
            min-height: 70px;
            border: 1px dashed rgba(255,255,255,0.30);
            border-radius: 6px;
            padding: 8px 10px;
            background: transparent;
            white-space: pre-wrap;
            word-break: break-word;
        }
        .analysis-inline-editor:focus {
            outline: none;
            border-color: #ffffff;
            box-shadow: 0 0 0 1px rgba(255,255,255,0.22);
            background: transparent;
        }
        .analysis-add-btn { margin-bottom: 8px; }
        .section-edit-btn, .section-edit-hint { display: none !important; }
        @keyframes editor-slide-in { from { transform: translate(-50%, -40px); opacity: 0; } to { transform: translate(-50%, 0); opacity: 1; } }
        .global-editor-panel.active { display: flex; }
        .editor-grp { display: flex; gap: 4px; border-right: 1px solid var(--retro-3); padding-right: 10px; }
        .editor-grp:last-child { border-right: none; }
        .editor-tool-btn {
            background: var(--retro-2); color: var(--paper); border: 1px solid var(--outline);
            border-radius: 4px; padding: 6px 10px; cursor: pointer; font-family: "Space Mono", monospace; font-weight: 700;
        }
        .editor-tool-btn:hover { background: var(--retro-3); color: var(--accent); }
        .editor-tool-btn.btn-active { background: var(--accent); color: var(--retro-black); }
        .editor-palette-dot {
            width: 22px;
            height: 22px;
            border-radius: 4px;
            border: 1px solid var(--outline);
            cursor: pointer;
            transition: transform 0.1s;
        }
        .editor-palette-dot:hover { transform: scale(1.15); border-color: var(--paper); }
        .editor-slider-wrap { display: flex; flex-direction: column; gap: 2px; }
        .editor-slider-label { font-size: 0.65rem; text-transform: uppercase; color: var(--text-muted); text-align: center; }
        .editor-opacity-slider { width: 80px; accent-color: var(--accent); cursor: pointer; }
        .editor-close { margin-left: 10px; background: var(--bad); border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 14px; cursor: pointer; }

        @media (max-width: 1280px) { .hud-grid { grid-template-columns: 1fr; } .overview-16x9 { aspect-ratio: auto; max-height: none; } }
        @media print {
            @page { size: 16in 9in; margin: 0.35in; }
            .report-actions { display: none !important; }
            details { border: none; padding: 0; background: transparent; }
            summary { display: list-item; }
            .box-level-1, .overview-16x9 {
                break-before: page;
                page-break-before: always;
                break-inside: auto;
                page-break-inside: auto;
            }
            #section-overview { break-before: auto; page-break-before: auto; }
            .box-header-actions { display: none !important; }
        }
        .cosmic-report-footer { margin-top: 2rem; padding: 1.25rem 1rem; border-top: 1px solid var(--outline); font-size: 0.78rem; color: var(--retro-12); text-align: center; line-height: 1.5; }
        .cosmic-report-footer a { color: var(--accent); text-decoration: underline; }
    </style>
</head>
<body>
<div class="container">
    <xsl:variable name="host_count" select="count(/nmaprun/host)"/>
    <xsl:variable name="up_count" select="count(/nmaprun/host[status/@state='up'])"/>
    <xsl:variable name="port_count" select="count(/nmaprun/host/ports/port)"/>
    <xsl:variable name="evidence_count" select="count(/nmaprun/cosmicevidence/item)"/>
    <xsl:variable name="first_os" select="/nmaprun/host[1]/os/osmatch[1]/@name"/>

    <div id="cosmic-modular-container" class="cosmic-modular-container">
    <div class="overview-16x9 section-edit-locked" id="section-overview">
        <div class="box-header-actions">
            <span class="box-drag-handle" title="Drag to reorder section">⋮⋮</span>
                    <button type="button" class="box-btn-reset" data-section-reset="section-overview" title="Reset this section to default">↺</button>
                    <button type="button" class="box-btn-remove" title="Remove section">×</button>
        </div>
        <div class="hud-grid">
            <div class="hud-card">
                <h3>Scope and Overview</h3>
                <div class="report-actions" style="margin-top: 0; margin-bottom: 8px;">
                    <button type="button" class="report-btn" id="scope-edit-toggle">Edit Scope</button>
                    <span class="hint-text" id="scope-edit-hint">Locked</span>
                </div>
                <div class="metric-row"><span>Target</span><span class="metric-value scope-metric-value" data-scope-key="target"><xsl:choose><xsl:when test="/nmaprun/host[1]/address/@addr"><xsl:value-of select="/nmaprun/host[1]/address/@addr"/></xsl:when><xsl:otherwise>Multiple</xsl:otherwise></xsl:choose></span></div>
                <div class="metric-row"><span>Scan Time</span><span class="metric-value scope-metric-value" data-scope-key="scan_time"><xsl:value-of select="/nmaprun/@startstr"/></span></div>
                <div class="metric-row"><span>Report Created</span><span class="metric-value scope-metric-value" data-scope-key="report_created"><xsl:choose><xsl:when test="/nmaprun/cosmicmeta/summary/@report_generated"><xsl:value-of select="/nmaprun/cosmicmeta/summary/@report_generated"/></xsl:when><xsl:otherwise>N/A</xsl:otherwise></xsl:choose></span></div>
                <div class="metric-row"><span>Hosts Online</span><span class="metric-value scope-metric-value" data-scope-key="hosts_online"><xsl:value-of select="$up_count"/> / <xsl:value-of select="$host_count"/></span></div>
                <div class="metric-row"><span>Total Ports</span><span class="metric-value scope-metric-value" data-scope-key="total_ports"><xsl:value-of select="$port_count"/></span></div>
                <xsl:if test="$first_os">
                    <div class="metric-row"><span>Suspected OS</span><span class="metric-value scope-metric-value" data-scope-key="suspected_os"><xsl:value-of select="$first_os"/></span></div>
                </xsl:if>
                <div class="metric-row">
                    <span>Tools Used</span>
                    <span class="metric-value scope-metric-value" data-scope-key="tools_used" style="text-align: right; max-width: 60%; word-break: break-all;">
                        <xsl:for-each select="/nmaprun/cosmicevidence/item[not(@tool = preceding-sibling::item/@tool)]">
                            <xsl:value-of select="@tool"/><xsl:if test="position() != last()">, </xsl:if>
                        </xsl:for-each>
                        <xsl:if test="not(/nmaprun/cosmicevidence/item)">Nmap</xsl:if>
                    </span>
                </div>
                <div class="metric-row">
                    <span>Total Discovery Time</span>
                    <span class="metric-value scope-metric-value" data-scope-key="discovery_time">
                        <xsl:choose>
                            <xsl:when test="/nmaprun/cosmicmeta/summary/@discovery_time_minutes"><xsl:value-of select="/nmaprun/cosmicmeta/summary/@discovery_time_minutes"/> mins</xsl:when>
                            <xsl:otherwise>Unknown</xsl:otherwise>
                        </xsl:choose>
                    </span>
                </div>
                <div class="report-actions">
                    <button type="button" class="report-btn" id="btn-export-html">Export HTML</button>
                    <button type="button" class="report-btn" id="btn-export-pdf">Export DIN 5008 PDF</button>
                </div>
            </div>

            <div class="hud-card hero-card">
                <div class="hero-sloth-block">
                <p class="hint-text" style="margin-top:0;">⚠️ <strong>Best Practice:</strong> Authorized security assessment data.</p>
                <pre id="hero-ascii-art" class="branding ascii-editor" contenteditable="true" spellcheck="false">  ____   __   __ ____  _____ ____  ____  ____  ____  ____  ____  _____  ____
 / ___) / _\ (  (  _ \(  __(  _ \/ ___)(_  _)(  __)(  _ \(  _ \(  __)(  _ \
 \___ \/    \/    ) __/ ) _) )   /\___ \  )(   ) _)  ) __/ ) __/ ) _)  )   /
 (____/\_/\_/\_)__(__) (____)(__\_)(____/ (__) (____)(__)  (__)  (__)  (__\_)</pre>
                </div>
                <div class="hero-note-block">
                    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
                        <label class="hero-note-label">Analyst note</label>
                    </div>
                    <div id="hero-note-input" class="analysis-inline-editor" contenteditable="true" data-placeholder="Click to add analyst note..." style="text-align: right; min-height: 100px; color: var(--paper); font-size: 0.82rem;"></div>
                </div>
                <div style="margin-top:10px; border-top: 1px solid var(--outline); padding-top: 8px;">
                    <label class="hero-note-label" style="font-size:0.72rem; opacity:0.7;">DIN 5008 Cover Fields</label>
                    <div style="display:grid; grid-template-columns: auto 1fr; gap: 4px 8px; font-size:0.78rem; margin-top:4px;">
                        <span style="color:var(--cream);">Organisation:</span>
                        <div class="inline-cell-editor" contenteditable="true" id="din-org" data-din-field="organisation" data-placeholder="Hochschule / Unternehmen"></div>
                        <span style="color:var(--cream);">Auftraggeber:</span>
                        <div class="inline-cell-editor" contenteditable="true" id="din-client" data-din-field="auftraggeber" data-placeholder="Auftraggeber / Labor"></div>
                        <span style="color:var(--cream);">Prüfer:</span>
                        <div class="inline-cell-editor" contenteditable="true" id="din-tester" data-din-field="pruefer" data-placeholder="Name / Rolle"></div>
                        <span style="color:var(--cream);">Vertraulichkeit:</span>
                        <div class="inline-cell-editor" contenteditable="true" id="din-confidentiality" data-din-field="vertraulichkeit" data-placeholder="Vertraulich / Intern"></div>
                    </div>
                </div>
            </div>

            <div class="hud-card theme-card" style="display: flex; flex-direction: column; height: 100%;">
                <h3 style="font-size: 0.9rem; margin-bottom: 8px;">Theme &amp; Palette</h3>
                <div class="report-actions" style="margin-top: 0; margin-bottom: 8px;">
                    <button type="button" class="report-btn" id="readability-toggle">Readability: On</button>
                </div>
                                <select id="unified-theme-selector" class="report-btn" size="18" style="height: 100%; flex: 1; text-align: left; padding: 10px; font-size: 0.85rem; outline: none;">
                    <option value="laurin">Laurin</option>
