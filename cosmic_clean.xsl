        }
        .evidence-raw-edit:hover { border-color: rgba(255,255,255,0.85); }
        .evidence-raw-edit:focus {
            outline: none;
            border-color: rgba(255,255,255,1);
            background: transparent;
        }
        .cosmic-edit-locked [contenteditable="true"]:not(.always-editable) {
            pointer-events: none;
            user-select: none;
            opacity: 0.85;
        }
        .cosmic-edit-locked .inline-cell-editor,
        .cosmic-edit-locked .evidence-inline-edit,
        .cosmic-edit-locked .evidence-raw-edit,
        .cosmic-edit-locked .scope-metric-value.scope-editing {
            pointer-events: none;
            user-select: none;
