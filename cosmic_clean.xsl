                    <option value="ink">Ink</option>
                    <option value="stonks">Stonks</option>
                    <option value="blk-36">BLK 36</option>
                    <option value="nopal-12">Nopal-12</option>
                    <option value="iridescent-crystal">Iridescent Crystal</option>
                    <option value="paperback-2">Paperback-2</option>
                    <option value="ephemera">EPHEMERA</option>
                    <option value="rickfoam">Rickfoam</option>
                    <option value="october">October Contest</option>
                    <option value="september">September Study</option>
                    <option value="endless">Endless</option>
                    <option value="arctic">Arctic</option>
                    <option value="nebula">Nebula</option>
                    <option value="resurrect64">Resurrect64</option>
                    <option value="kalicharizard">KaliCharizard</option>
