        .overview-16x9 { aspect-ratio: 16 / 9; min-height: 430px; max-height: 88vh; overflow: auto; border: 2px solid var(--outline); border-radius: 8px; background: linear-gradient(180deg, var(--retro-2) 0%, var(--retro-1) 100%); padding: 16px; margin-bottom: 16px; }
